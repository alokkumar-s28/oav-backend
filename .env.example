# Admin Token for Admin Panel access
ADMIN_TOKEN=your_secure_admin_token_here
PORT=3000

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Drive Storage Configuration
# Method 1 (Recommended): Google Apps Script Web App (Deploy GoogleDriveUploader.gs under oavmantra@gmail.com)
GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Method 2: Google Service Account
# Save JSON as backend/oav-backend/google-service-account.json
GOOGLE_DRIVE_FOLDER_ID=your_photos_folder_id
GOOGLE_DRIVE_PAYMENTS_FOLDER_ID=your_payments_folder_id

# Admin Email Alert Configuration
ADMIN_NOTIFICATION_EMAIL=oavmantra@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=oavmantra@gmail.com
SMTP_PASS=your_gmail_app_password

